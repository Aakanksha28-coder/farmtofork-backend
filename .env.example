# Server Configuration
PORT=5000

# MongoDB Connection
# For local development: mongodb://localhost:27017/farm-to-fork
# For production (MongoDB Atlas): mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/farm-to-fork?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/farm-to-fork

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRE=30d

# Indian Government API Key (data.gov.in)
DATA_GOV_API_KEY=your_api_key_here

# Admin User Credentials
ADMIN_EMAIL=admin@farmtofork.com
ADMIN_PASSWORD=your_secure_password_here
ADMIN_NAME=Administrator

# Email Configuration (Gmail SMTP — free)
# 1. Enable 2-Step Verification on your Google account
# 2. Go to https://myaccount.google.com/apppasswords
# 3. Generate an App Password for "Mail"
# 4. Use that 16-char password below (NOT your regular Gmail password)
EMAIL_USER=your_gmail@gmail.com
EMAIL_PASS=your_16char_app_password

# GREEN-API WhatsApp (free — https://console.green-api.com)
# 1. Register and create a Developer instance (free)
# 2. Scan QR code with your WhatsApp
# 3. Copy idInstance and apiTokenInstance below
GREEN_API_INSTANCE_ID=your_instance_id
GREEN_API_TOKEN=your_api_token

# Frontend URL (used in email links)
FRONTEND_URL=https://farmtofork-frontend.onrender.com
