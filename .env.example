# App
PORT=5000
NODE_ENV=development
BRAND_NAME=FarmToFork
FRONTEND_URL=http://localhost:3000

# Database
MONGO_URI=mongodb://127.0.0.1:27017/farm-to-fork

# JWT
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRE=7d

# SMTP / Nodemailer
# Example for Gmail App Password:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your_gmail@gmail.com
# SMTP_PASS=your_16_character_app_password
# EMAIL_FROM=FarmToFork <your_gmail@gmail.com>
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@example.com
SMTP_PASS=your_smtp_password
EMAIL_FROM=FarmToFork <your_email@example.com>

# Optional admin seed
ADMIN_EMAIL=admin@farmtofork.com
ADMIN_PASSWORD=ChangeThisAdminPassword123
ADMIN_NAME=Administrator

# Existing optional integrations used elsewhere in the app
DATA_GOV_API_KEY=
GREEN_API_INSTANCE_ID=
GREEN_API_TOKEN=
FAST2SMS_API_KEY=
